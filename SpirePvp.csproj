<Project Sdk="Godot.NET.Sdk/4.5.1">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
        <!-- Mods are MSIL while the game dlls are win-x64; silence the mismatch warning. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <!-- Cross-platform game path discovery. Override with -p:Sts2Path=... if Steam lives elsewhere. -->
    <PropertyGroup>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
    </PropertyGroup>

    <!-- Windows -->
    <PropertyGroup Condition="'$(IsOSX)' != 'true' and '$(IsLinux)' != 'true'">
        <Sts2Path Condition="'$(Sts2Path)' == '' and Exists('D:/SteamLibrary/steamapps/common/Slay the Spire 2')">D:/SteamLibrary/steamapps/common/Slay the Spire 2</Sts2Path>
        <Sts2Path Condition="'$(Sts2Path)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2</Sts2Path>
        <Sts2DataDir>$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
        <ModsPath>$(Sts2Path)/mods/</ModsPath>
    </PropertyGroup>

    <!-- macOS: data dir lives inside the .app bundle; arch varies (arm64 on Apple Silicon) -->
    <PropertyGroup Condition="'$(IsOSX)' == 'true'">
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2</Sts2Path>
        <Sts2Resources>$(Sts2Path)/SlayTheSpire2.app/Contents/Resources</Sts2Resources>
        <Sts2DataDir Condition="Exists('$(Sts2Resources)/data_sts2_macos_arm64')">$(Sts2Resources)/data_sts2_macos_arm64</Sts2DataDir>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Resources)/data_sts2_macos_x86_64</Sts2DataDir>
        <ModsPath>$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
    </PropertyGroup>

    <!-- Linux -->
    <PropertyGroup Condition="'$(IsLinux)' == 'true'">
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Slay the Spire 2</Sts2Path>
        <Sts2DataDir>$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
        <ModsPath>$(Sts2Path)/mods/</ModsPath>
    </PropertyGroup>

    <Target Name="CheckSts2Path" BeforeTargets="BeforeBuild">
        <Error Text="Slay the Spire 2 data not found at '$(Sts2DataDir)'. Install the game or pass -p:Sts2Path=&quot;/path/to/Slay the Spire 2&quot;"
               Condition="!Exists('$(Sts2DataDir)')"/>
    </Target>

    <ItemGroup>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Lets us call the game's private/internal members without reflection boilerplate. -->
    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false"/>
    </ItemGroup>

    <!--
      Stamps the build's git commit into the mod version.

      The engine refuses a connection when the two players' gameplay-affecting mods differ, and
      it compares `id + "-" + version` (ModManager.GetGameplayRelevantModNameList). With a static
      version every build reported "SpirePvp-0.1.0", so two *different commits* passed that gate
      — and the only thing left between them was the ModelDb hash, which is unchanged by most of
      our commits. Two mismatched builds could therefore connect and then disagree, because net
      message ids are positional. The README already promised "you must both be on the same
      commit"; this is what makes the engine enforce it rather than us asking nicely.

      Marked -dirty when the tree has uncommitted changes, since a shared commit hash says
      nothing about code only one side has.

      Written to obj/ rather than over the tracked file, so building never dirties the tree it
      is reporting on. Falls back to the plain manifest when git is unavailable — the mod still
      works, it just loses the guarantee.

      **Debug only, and the distinction is the point.** Git runs on whoever *builds*, never on a
      player's machine — so which distribution route is in use decides whether a hash is wanted:

        - Built from a clone (how this is shared today): every player builds their own copy, so
          two people can hold the same declared version and different code. The hash is the only
          thing that catches that.
        - Published to the Workshop: one person builds once and every subscriber receives that
          identical file, so they match by construction. A commit hash there is noise in a
          user-visible version string, and it would pin the release to a machine that happened
          to have git.

      So release builds keep the declared semver and are bumped deliberately, which is what a
      published version is for. `dotnet build -c Release` is the publish build.
    -->
    <Target Name="StampModVersion" BeforeTargets="CopyToModsFolder"
            Condition="'$(Configuration)' == 'Debug'">
        <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short HEAD"
              ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit"/>
            <Output TaskParameter="ExitCode" PropertyName="GitExitCode"/>
        </Exec>
        <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; status --porcelain"
              ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitDirty"/>
        </Exec>

        <PropertyGroup Condition="'$(GitExitCode)' == '0' and '$(GitCommit)' != ''">
            <ModVersionSuffix>+$(GitCommit.Trim())</ModVersionSuffix>
            <ModVersionSuffix Condition="'$(GitDirty)' != ''">$(ModVersionSuffix)-dirty</ModVersionSuffix>
            <StampedManifest>$(IntermediateOutputPath)SpirePvp.json</StampedManifest>
            <ManifestText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/SpirePvp.json'))</ManifestText>
            <ManifestText>$([System.Text.RegularExpressions.Regex]::Replace($(ManifestText), '("version"\s*:\s*"[^"]+)"', '$1$(ModVersionSuffix)"'))</ManifestText>
        </PropertyGroup>

        <WriteLinesToFile File="$(StampedManifest)" Lines="$(ManifestText)" Overwrite="true"
                          WriteOnlyWhenDifferent="true" Condition="'$(StampedManifest)' != ''"/>
    </Target>

    <Target Name="CopyToModsFolder" AfterTargets="PostBuildEvent" DependsOnTargets="StampModVersion">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)SpirePvp/"/>
        <Copy SourceFiles="$(MSBuildProjectDirectory)/SpirePvp.json" DestinationFolder="$(ModsPath)SpirePvp/"
              Condition="'$(StampedManifest)' == ''"/>
        <Copy SourceFiles="$(StampedManifest)" DestinationFolder="$(ModsPath)SpirePvp/"
              Condition="'$(StampedManifest)' != ''"/>
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModsPath)SpirePvp/" Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>

        <!--
          The committed .pck, so that `git clone && dotnet build` is a complete install.

          Without this a fresh clone builds and runs with no localization at all: every modifier,
          menu entry and badge renders as a raw loc key. `dotnet build` does not produce a .pck —
          only the Godot editor does — which is exactly why it is committed rather than ignored,
          and why it has to be copied like any other build output.

          Skipped when absent so a working tree mid-export still builds.
        -->
        <Copy SourceFiles="$(MSBuildProjectDirectory)/SpirePvp.pck" DestinationFolder="$(ModsPath)SpirePvp/" Condition="Exists('$(MSBuildProjectDirectory)/SpirePvp.pck')"/>
    </Target>
</Project>
