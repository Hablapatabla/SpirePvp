<Project Sdk="Godot.NET.Sdk/4.5.1">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
        <!-- Mods are MSIL while the game dlls are win-x64; silence the mismatch warning. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <!-- Cross-platform game path discovery. Override with -p:Sts2Path=... if Steam lives elsewhere. -->
    <PropertyGroup>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
    </PropertyGroup>

    <!-- Windows -->
    <PropertyGroup Condition="'$(IsOSX)' != 'true' and '$(IsLinux)' != 'true'">
        <Sts2Path Condition="'$(Sts2Path)' == '' and Exists('D:/SteamLibrary/steamapps/common/Slay the Spire 2')">D:/SteamLibrary/steamapps/common/Slay the Spire 2</Sts2Path>
        <Sts2Path Condition="'$(Sts2Path)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2</Sts2Path>
        <Sts2DataDir>$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
        <ModsPath>$(Sts2Path)/mods/</ModsPath>
    </PropertyGroup>

    <!-- macOS: data dir lives inside the .app bundle; arch varies (arm64 on Apple Silicon) -->
    <PropertyGroup Condition="'$(IsOSX)' == 'true'">
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2</Sts2Path>
        <Sts2Resources>$(Sts2Path)/SlayTheSpire2.app/Contents/Resources</Sts2Resources>
        <Sts2DataDir Condition="Exists('$(Sts2Resources)/data_sts2_macos_arm64')">$(Sts2Resources)/data_sts2_macos_arm64</Sts2DataDir>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Resources)/data_sts2_macos_x86_64</Sts2DataDir>
        <ModsPath>$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
    </PropertyGroup>

    <!-- Linux -->
    <PropertyGroup Condition="'$(IsLinux)' == 'true'">
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Slay the Spire 2</Sts2Path>
        <Sts2DataDir>$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
        <ModsPath>$(Sts2Path)/mods/</ModsPath>
    </PropertyGroup>

    <Target Name="CheckSts2Path" BeforeTargets="BeforeBuild">
        <Error Text="Slay the Spire 2 data not found at '$(Sts2DataDir)'. Install the game or pass -p:Sts2Path=&quot;/path/to/Slay the Spire 2&quot;"
               Condition="!Exists('$(Sts2DataDir)')"/>
    </Target>

    <ItemGroup>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Lets us call the game's private/internal members without reflection boilerplate. -->
    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false"/>
    </ItemGroup>

    <Target Name="CopyToModsFolder" AfterTargets="PostBuildEvent">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)SpirePvp/"/>
        <Copy SourceFiles="$(MSBuildProjectDirectory)/SpirePvp.json" DestinationFolder="$(ModsPath)SpirePvp/"/>
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModsPath)SpirePvp/" Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>

        <!--
          The committed .pck, so that `git clone && dotnet build` is a complete install.

          Without this a fresh clone builds and runs with no localization at all: every modifier,
          menu entry and badge renders as a raw loc key. `dotnet build` does not produce a .pck —
          only the Godot editor does — which is exactly why it is committed rather than ignored,
          and why it has to be copied like any other build output.

          Skipped when absent so a working tree mid-export still builds.
        -->
        <Copy SourceFiles="$(MSBuildProjectDirectory)/SpirePvp.pck" DestinationFolder="$(ModsPath)SpirePvp/" Condition="Exists('$(MSBuildProjectDirectory)/SpirePvp.pck')"/>
    </Target>
</Project>
